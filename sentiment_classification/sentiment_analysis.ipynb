{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Sentiment Classification System\n",
        "\n",
        "This notebook demonstrates a full sentiment analysis pipeline. It loads a CSV dataset, preprocesses the text, converts it to numeric features, trains three models (Naive Bayes, SVM, Random Forest), evaluates them, visualises results, and includes a TextBlob baseline.\n",
        "\n",
        "**Folder structure**\n",
        "- `dataset/sentiment_data.csv` – input data (you can replace with your own).\n",
        "- `models/` – trained model files are saved here.\n",
        "- `outputs/` – generated plots are saved here."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Standard imports\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import json\n",
        "import re\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.feature_extraction.text import CountVectorizer, TfidfTransformer, TfidfVectorizer\n",
        "from sklearn.naive_bayes import MultinomialNB\n",
        "from sklearn.svm import LinearSVC\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score, precision_score, recall_score, f1_score\n",
        "from textblob import TextBlob\n",
        "import joblib\n",
        "import os\n",
        "sns.set(style=\"whitegrid\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Load dataset\n",
        "data_path = os.path.join('dataset', 'sentiment_data.csv')\n",
        "df = pd.read_csv(data_path)\n",
        "# Ensure column names are as expected\n",
        "df.columns = [c.strip() for c in df.columns]\n",
        "df.head()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Simple preprocessing\n",
        "def preprocess(text):\n",
        "    # Lowercase\n",
        "    text = text.lower()\n",
        "    # Remove punctuation\n",
        "    text = re.sub(r'[\n\r]', ' ', text)\n",
        "    text = re.sub(r'[^a-zA-Z0-9\s]', '', text)\n",
        "    # Tokenize (optional – CountVectorizer will handle tokenization)\n",
        "    return text.strip()\n",
        "\n",
        "df['clean_text'] = df['text'].apply(preprocess)\n",
        "df['label'] = df['sentiment'].astype('category').cat.codes  # 0,1,2\n",
        "df[['clean_text','label']].head()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Vectorization\n",
        "vectorizer = CountVectorizer(stop_words='english')\n",
        "X_counts = vectorizer.fit_transform(df['clean_text'])\n",
        "tfidf_transformer = TfidfTransformer()\n",
        "X_tfidf = tfidf_transformer.fit_transform(X_counts)\n",
        "y = df['label']\n",
        "X_train, X_test, y_train, y_test = train_test_split(X_tfidf, y, test_size=0.2, random_state=42, stratify=y)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Train models\n",
        "# 1. Multinomial Naive Bayes\n",
        "nb_clf = MultinomialNB()\n",
        "nb_clf.fit(X_train, y_train)\n",
        "# 2. Linear SVM\n",
        "svm_clf = LinearSVC()\n",
        "svm_clf.fit(X_train, y_train)\n",
        "# 3. Random Forest\n",
        "rf_clf = RandomForestClassifier(n_estimators=200, random_state=42)\n",
        "rf_clf.fit(X_train, y_train)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Evaluation helper\n",
        "def evaluate_model(name, model, X_test, y_test):\n",
        "    preds = model.predict(X_test)\n",
        "    acc = accuracy_score(y_test, preds)\n",
        "    prec = precision_score(y_test, preds, average='weighted', zero_division=0)\n",
        "    rec = recall_score(y_test, preds, average='weighted', zero_division=0)\n",
        "    f1 = f1_score(y_test, preds, average='weighted', zero_division=0)\n",
        "    print(f'--- {name} ---')\n",
        "    print(classification_report(y_test, preds, target_names=df['sentiment'].astype('category').cat.categories))\n",
        "    cm = confusion_matrix(y_test, preds)\n",
        "    return {'name': name, 'accuracy': acc, 'precision': prec, 'recall': rec, 'f1': f1, 'confusion': cm}"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Evaluate all three models\n",
        "results = []\n",
        "results.append(evaluate_model('Naive Bayes', nb_clf, X_test, y_test))\n",
        "results.append(evaluate_model('Linear SVM', svm_clf, X_test, y_test))\n",
        "results.append(evaluate_model('Random Forest', rf_clf, X_test, y_test))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Plot accuracy comparison\n",
        "plt.figure(figsize=(6,4))\n",
        "names = [r['name'] for r in results]\",
        "accs = [r['accuracy'] for r in results]\",
        "sns.barplot(x=names, y=accs, palette='viridis')\",
        "plt.title('Model Accuracy Comparison')\",
        "plt.ylabel('Accuracy')\",
        "plt.ylim(0,1)\",
        "for i, v in enumerate(accs):\n",
        "    plt.text(i, v + 0.02, f'{v:.2f}', ha='center')\",
        "output_path = os.path.join('outputs', 'accuracy_comparison.png')\",
        "os.makedirs('outputs', exist_ok=True)\",
        "plt.savefig(output_path, dpi=150, bbox_inches='tight')\",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Plot confusion matrices for each model\n",
        "for r in results:\n",
        "    cm = r['confusion']\n",
        "    plt.figure(figsize=(5,4))\n",
        "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', cbar=False)\n",
        "    plt.title(f'Confusion Matrix - {r[\"name\"]}')\",
        "    plt.xlabel('Predicted')\",
        "    plt.ylabel('True')\",
        "    plt.savefig(os.path.join('outputs', f'confusion_{r[\"name\"].replace(' ', '_').lower()}.png'), dpi=150, bbox_inches='tight')\",
        "    plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# TextBlob baseline\n",
        "def textblob_sentiment(text):\n",
        "    blob = TextBlob(text)\n",
        "    polarity = blob.sentiment.polarity\n",
        "    # Simple rule: polarity > 0 => positive, <0 => negative, else neutral\n",
        "    if polarity > 0.1:\n",
        "        return 0  # assuming 0 = positive after label encoding\",
        "    elif polarity < -0.1:\n",
        "        return 1  # negative\",
        "    else:\n",
        "        return 2  # neutral\",
        "\n",
        "df['blob_pred'] = df['clean_text'].apply(textblob_sentiment)\n",
        "blob_acc = accuracy_score(y_test, df.iloc[y_test.index]['blob_pred'])\n",
        "print(f'TextBlob baseline accuracy: {blob_acc:.2f}')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Save trained models\n",
        "os.makedirs('models', exist_ok=True)\n",
        "joblib.dump(nb_clf, os.path.join('models', 'naive_bayes.pkl'))\n",
        "joblib.dump(svm_clf, os.path.join('models', 'linear_svm.pkl'))\n",
        "joblib.dump(rf_clf, os.path.join('models', 'random_forest.pkl'))\n",
        "print('Models saved to ./models/')"
      ]
    }
  ],
